# ── Database ──────────────────────────────────────────────────────────────────
# Neon, Supabase, Railway Postgres, or any Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── AI ────────────────────────────────────────────────────────────────────────
# OpenAI-compatible base URL (use https://api.openai.com/v1 for OpenAI directly)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# ── Location search ───────────────────────────────────────────────────────────
# Get a free key at https://myprojects.geoapify.com
GEOAPIFY_API_KEY=your_geoapify_key

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/integrations/google-cal/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# Guards the analytics/crash read endpoints (/api/events/summary, /api/events/errors).
# UNSET IN PRODUCTION = those endpoints 404. That is deliberate: they return
# error messages and stack traces, so falling open would publish them.
# Any long random string; generate with: openssl rand -hex 24
ADMIN_TOKEN=
