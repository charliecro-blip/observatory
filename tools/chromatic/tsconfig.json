{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["engine/**/*.ts", "playground/**/*.ts", "test/**/*.ts"],
  "exclude": ["playground/vite.config.ts", "test/render-gallery.ts", "test/escaping.test.ts", "test/update-golden.ts"]
}
